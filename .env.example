# Cấu hình chạy cục bộ. run.sh / run.ps1 tự chép tệp này thành .env và sinh JWT_SECRET ở lần đầu.
# Không commit .env (đã có trong .gitignore).

# Khoá ký JWT — API CSDL phát token, API mô hình xác minh token, nên hai bên PHẢI dùng chung.
# Tự sinh: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# split  = 3 module chạy 3 cổng riêng (run.sh / run.ps1)
# single = 1 tiến trình gộp cả 3 module (Render, hoặc: uvicorn app:app)
SERVICE_MODE=split

# CSDL SQLite của API CSDL (đường dẫn tương đối tính từ thư mục iris-fastapi)
DB_PATH=data/app.db
# Đặt DATABASE_URL thì API CSDL dùng PostgreSQL thay cho SQLite (Render: Internal Database URL).
# Để trống khi chạy cục bộ. Ví dụ: postgresql://user:password@host:5432/iris_svm
DATABASE_URL=
# Trang "Dữ liệu SQL" chỉ mở cho các tài khoản trong SQL_VIEWER_USERS; seed.py tạo chúng với mật khẩu
# ADMIN_PASSWORD (run.sh / run.ps1 tự sinh). Để trống ADMIN_PASSWORD = tắt trang này.
SQL_VIEWER_USERS=admin
ADMIN_PASSWORD=
# Chỉ dùng cho công cụ xem dữ liệu db_viewer.py (chỉ đọc): External Database URL của Render Postgres.
# Không bắt buộc — để trống thì db_viewer.py hỏi URL (ẩn khi gõ). .env không được commit.
EXTERNAL_DATABASE_URL=
# Múi giờ dùng cho bộ lọc ngày và thời gian trong file Excel (Việt Nam = 7)
APP_TZ_OFFSET_HOURS=7

# Cổng và địa chỉ của 3 module khi chạy tách
MODEL_API_PORT=8000
DB_API_PORT=8001
WEB_PORT=8080
MODEL_API_URL=http://127.0.0.1:8000
DB_API_URL=http://127.0.0.1:8001
WEB_URL=http://127.0.0.1:8080/

# CORS: API CSDL chỉ nhận request từ trang web; API mô hình là API công khai
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
MODEL_API_CORS_ORIGINS=*
